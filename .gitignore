# Dependencies (reinstalled via `npm install`)
node_modules/

# Packaged builds
dist/
out/
*.exe
*.dmg
*.AppImage

# electron-builder resource dir: ignore generated output but KEEP the source
# icon assets it (and the BrowserWindow icon path) depend on — see package.json
# "build.files" / win.icon and main.js. Without these committed, a fresh clone
# can't build or show an app icon.
build/*
!build/icon.ico
!build/icon.png
!build/icon.svg
!build/gen-icon.js

# Logs & OS cruft
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Local app data is stored under %APPDATA%\timesheet (outside the repo) and is
# never committed — listed here only as a reminder.
