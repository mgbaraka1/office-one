# Dependencies (reinstalled via `npm install`)
node_modules/

# Packaged builds
dist/
out/
*.exe
*.dmg
*.AppImage

# electron-builder resource dir: ignore generated output but KEEP the source
# icon assets it (and the BrowserWindow icon path) depend on — see package.json
# "build.files" / win.icon and main.js. Without these committed, a fresh clone
# can't build or show an app icon.
build/*
!build/icon.ico
!build/icon.png
!build/icon.svg
!build/gen-icon.js

# Logs & OS cruft
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Codex Security scan working artifacts (reports, ledgers, and local PoCs)
.codex-security-stage/

# Environment / secrets — commit only the example, never a real .env
.env
.env.*
!.env.example

# SQLite database files must never be committed. The live store lives under
# %APPDATA%\office-one (outside the repo); these patterns are a safety net in case
# a copy is ever placed in the working tree.
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
backups/

# Local app data is stored under %APPDATA%\office-one (outside the repo) and is
# never committed — listed here only as a reminder.

# Internal working documents — kept in the working copy, never published.
# CLAUDE.md is the local developer/agent reference and FINANCE_INTEGRATION_PLAN.md
# is a mid-migration planning doc; both are notes to ourselves, not documentation
# for anyone cloning this repository. CONTRIBUTING.md is the public equivalent.
CLAUDE.md
FINANCE_INTEGRATION_PLAN.md
