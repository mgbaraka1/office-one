# Editor defaults for this repository. Pairs with .gitattributes (which pins
# what git STORES) and eslint.config.js (which checks what the code MEANS);
# this file is what your editor applies while you type.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false

[*.{ico,png,jpg,gif,webp,exe}]
insert_final_newline = false
trim_trailing_whitespace = false

# Vendored third-party code (Quill, DOMPurify) is left exactly as shipped.
[renderer/vendor/**]
indent_style = unset
indent_size = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
