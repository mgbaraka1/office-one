{
  "name": "timesheet",
  "version": "3.0.0",
  "description": "Cooperation Tools — an offline, multi-user Electron desktop app for tracking daily timesheets, recurring subscriptions, client/system Projects, renewal-tracked Company Documents, and per-client VPN/server reference info, with read-only analytics and PDF reports. Each account's data is isolated. Data is stored in a self-contained, zero-config embedded SQLite database (Node's built-in node:sqlite, bundled with Electron — no server, no separate install, no native build).",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "pack": "electron-builder --dir"
  },
  "keywords": [
    "electron",
    "timesheet",
    "subscriptions",
    "projects",
    "analytics",
    "multi-user",
    "desktop",
    "sqlite",
    "node:sqlite",
    "offline"
  ],
  "author": "Moustafa Baraka",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "electron": "^42.3.3",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.mostafa.cooperationtools",
    "productName": "Cooperation Tools",
    "files": [
      "main.js",
      "db.js",
      "auth.js",
      "backup.js",
      "preload.js",
      "ipc-types.js",
      "index.html",
      "migrations/**/*",
      "package.json",
      "build/icon.ico",
      "build/icon.png",
      "node_modules/bcryptjs/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Cooperation Tools"
    },
    "directories": {
      "output": "dist"
    }
  },
  "dependencies": {
    "bcryptjs": "^3.0.3"
  }
}
